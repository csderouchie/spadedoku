[gd_scene format=3 uid="uid://cl1dyb21jeapt"]

[ext_resource type="Script" uid="uid://72hwbqgnnn7d" path="res://Scripts/Menus/select_level_button.gd" id="1_lnbxk"]

[sub_resource type="GDScript" id="GDScript_7pcsv"]
script/source = "extends Control
@onready var buttons_vbox: VBoxContainer = $ColorRect/VBoxContainer/MarginContainer/Buttons/ButtonsVbox
signal level_selected
var page : int

func set_buttons():
	page = 1
	var containers = buttons_vbox.get_children()
	var num := 0
	for container in containers:
		var buttons = container.get_children()
		for button in buttons:
			button.num = num
			button.set_button_text()
			num += 1

func _on__level_selected(num) -> void:
	level_selected.emit(num)

func _on_previous_pressed() -> void:
	if page > 1:
		var containers = buttons_vbox.get_children()
		for container in containers:
			var buttons = container.get_children()
			for button in buttons:
				button.num -= 25
				button.set_button_text()
		page -= 1
				

func _on_next_pressed() -> void:
	if page < 4:
		var containers = buttons_vbox.get_children()
		for container in containers:
			var buttons = container.get_children()
			for button in buttons:
				button.num += 25
				button.set_button_text()
		page += 1

signal menu
func _on_menu_pressed() -> void:
	menu.emit()
"

